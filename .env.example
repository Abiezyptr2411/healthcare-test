# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Auth Service
AUTH_SERVICE_PORT=3001
AUTH_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/auth_db?schema=public
JWT_SECRET=supersecret-healthcare-jwt-key-change-in-production
JWT_EXPIRES_IN=1h

# Schedule Service
SCHEDULE_SERVICE_PORT=3002
SCHEDULE_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/schedule_db?schema=public
AUTH_SERVICE_URL=http://auth-service:3001/graphql

# Redis (Caching & BullMQ Queue)
REDIS_HOST=redis
REDIS_PORT=6379

# Mailpit (Email Notification Mock SMTP)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="Healthcare System <noreply@healthcare.local>"

